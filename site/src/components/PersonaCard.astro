---
import type { Persona } from "../data/personas";
import { categoryBySlug } from "../data/categories";
import { skillsByCategory } from "../data/skills-meta";
import PersonaAvatar from "./PersonaAvatar.astro";

interface Props {
  persona: Persona;
  variant?: "full" | "compact";
}

const { persona, variant = "full" } = Astro.props;
const category = categoryBySlug.get(persona.category)!;
const skills = skillsByCategory(persona.category);
---

{variant === "full" ? (
  <article class="grid md:grid-cols-12 gap-8 border-b border-[var(--color-brand-rule)] pb-12">
    <div class="md:col-span-3">
      <PersonaAvatar persona={persona} size="xl" link={false} />
      <div class="mt-4">
        <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-red)] mb-1">
          {category.name}
        </div>
        <h3 class="font-display text-2xl leading-tight">{persona.name}</h3>
        <p class="font-mono text-xs text-[var(--color-brand-muted)] tracking-wider uppercase mt-1">{persona.role}</p>
      </div>
    </div>
    <div class="md:col-span-9 space-y-5">
      <blockquote class="font-display text-2xl md:text-3xl leading-snug text-[var(--color-brand-black)] border-l-4 border-[var(--color-brand-red)] pl-5 py-1">
        "{persona.philosophy}"
      </blockquote>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-[15px] leading-relaxed text-[var(--color-brand-black)]/85">
        <div>
          <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)] mb-2">Voice</div>
          <p>{persona.voice}</p>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)] mb-2">Origin</div>
          <p>{persona.origin}</p>
        </div>
      </div>
      <div>
        <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)] mb-3">
          Owns {skills.length} {skills.length === 1 ? "skill" : "skills"}
        </div>
        <div class="flex flex-wrap gap-2">
          {skills.map((s) => (
            <a
              href={`/skills/${s.slug}/`}
              class="font-mono text-xs tracking-wider border border-[var(--color-brand-rule)] hover:border-[var(--color-brand-black)] hover:text-[var(--color-brand-red)] px-3 py-1 transition-colors"
            >{s.name}</a>
          ))}
        </div>
      </div>
    </div>
  </article>
) : (
  <article class="flex items-start gap-4 p-4 border border-[var(--color-brand-rule)] hover:border-[var(--color-brand-black)] transition-colors">
    <PersonaAvatar persona={persona} size="md" link={false} />
    <div class="flex-1 min-w-0">
      <div class="font-mono text-[9px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)]">{category.name}</div>
      <h4 class="font-display text-lg leading-tight">{persona.name}</h4>
      <p class="font-mono text-[10px] tracking-wider uppercase text-[var(--color-brand-muted)]">{persona.role}</p>
      <p class="text-sm mt-2 text-[var(--color-brand-black)]/80 leading-snug">{persona.oneLiner}</p>
    </div>
  </article>
)}
