---
import type { Persona } from "../data/personas";
import { categoryBySlug } from "../data/categories";
import { skillsByCategory } from "../data/skills-meta";
import PersonaAvatar from "./PersonaAvatar.astro";

interface Props {
  persona: Persona;
  variant?: "full" | "compact";
}

const { persona, variant = "full" } = Astro.props;
const category = categoryBySlug.get(persona.category)!;
const skills = skillsByCategory(persona.category);
---

{variant === "full" ? (
  <article class="grid md:grid-cols-12 gap-10 border-b border-[var(--color-rule)] pb-16">
    <div class="md:col-span-3">
      <PersonaAvatar persona={persona} size="xl" link={false} breathe={true} />
      <div class="mt-5">
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-1">
          {category.name}
        </div>
        <h3 class="font-display text-2xl leading-tight text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50, 'WONK' 1;">{persona.name}</h3>
        <p class="font-mono text-xs text-[var(--color-ink-tertiary)] tracking-[0.18em] uppercase mt-1">{persona.role}</p>
      </div>
    </div>
    <div class="md:col-span-9 space-y-6">
      <blockquote class="font-display text-2xl md:text-3xl leading-snug text-[var(--color-ink-primary)] border-l-4 border-[var(--color-brand-red)] pl-5 py-1 italic" style="font-variation-settings: 'SOFT' 50, 'WONK' 1;">
        "{persona.philosophy}"
      </blockquote>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-5 text-[15px] leading-relaxed text-[var(--color-ink-primary)]/90">
        <div>
          <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-2">Voice</div>
          <p>{persona.voice}</p>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-2">Origin</div>
          <p>{persona.origin}</p>
        </div>
      </div>
      <div>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-3">
          Owns {skills.length} {skills.length === 1 ? "skill" : "skills"}
        </div>
        <div class="flex flex-wrap gap-2">
          {skills.map((s) => (
            <a href={`/skills/${s.slug}/`} class="font-mono text-xs tracking-[0.05em] border border-[var(--color-rule)] text-[var(--color-ink-secondary)] hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)] px-3 py-1 transition-colors duration-200">{s.name}</a>
          ))}
        </div>
      </div>
    </div>
  </article>
) : (
  <article class="flex items-start gap-4 p-4 border border-[var(--color-rule)] bg-[var(--color-bg-elev-1)] hover:border-[var(--color-rule-strong)] transition-colors">
    <PersonaAvatar persona={persona} size="md" link={false} />
    <div class="flex-1 min-w-0">
      <div class="font-mono text-[9px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)]">{category.name}</div>
      <h4 class="font-display text-lg leading-tight text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50;">{persona.name}</h4>
      <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-ink-tertiary)]">{persona.role}</p>
      <p class="text-sm mt-2 text-[var(--color-ink-secondary)] leading-snug">{persona.oneLiner}</p>
    </div>
  </article>
)}
