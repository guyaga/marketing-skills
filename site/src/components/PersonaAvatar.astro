---
import type { Persona } from "../data/personas";

interface Props {
  persona: Persona;
  size?: "sm" | "md" | "lg" | "xl" | "hero";
  link?: boolean;
  breathe?: boolean;
  eager?: boolean;
}

const { persona, size = "md", link = true, breathe = false, eager = false } = Astro.props;

const sizeMap = {
  sm: { class: "w-12 h-12", srcSize: 96, displayPx: 48 },
  md: { class: "w-20 h-20", srcSize: 192, displayPx: 80 },
  lg: { class: "w-32 h-32", srcSize: 192, displayPx: 128 },
  xl: { class: "w-48 h-48", srcSize: 384, displayPx: 192 },
  hero: { class: "w-72 h-72 md:w-96 md:h-96", srcSize: 768, displayPx: 384 },
};
const cfg = sizeMap[size];

const Tag = link ? "a" : "div";
const tagProps = link ? { href: `/categories/${persona.category}/` } : {};

const slug = persona.avatarSlug;
const baseDir = "/avatars";
---

<Tag {...tagProps} class="persona-avatar inline-block group">
  <div class={`${cfg.class} relative bg-[var(--color-bg-elev-2)] border border-[var(--color-rule-strong)] overflow-hidden ${breathe ? "persona-breathe" : ""}`}>
    <picture>
      <source
        type="image/webp"
        srcset={`${baseDir}/${slug}-96.webp 96w, ${baseDir}/${slug}-192.webp 192w, ${baseDir}/${slug}-384.webp 384w, ${baseDir}/${slug}-768.webp 768w`}
        sizes={`${cfg.displayPx}px`}
      />
      <img
        src={`${baseDir}/${slug}.png`}
        alt={`${persona.name}, ${persona.role}`}
        width={cfg.srcSize}
        height={cfg.srcSize}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={eager ? "high" : "auto"}
        class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
        onerror="this.style.opacity='0.15';this.style.filter='blur(0.5px)'"
      />
    </picture>
    <span class="pointer-events-none absolute inset-0 ring-1 ring-[var(--color-brand-red)]/0 group-hover:ring-[var(--color-brand-red)]/40 transition-all duration-300"></span>
  </div>
</Tag>

<style>
  .persona-breathe img {
    animation: breathe 4.5s ease-in-out infinite;
    will-change: filter;
  }
  @media (prefers-reduced-motion: reduce) {
    .persona-breathe img { animation: none; }
  }
</style>
