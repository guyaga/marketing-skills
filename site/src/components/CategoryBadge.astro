---
import { categoryBySlug } from "../data/categories";

interface Props {
  slug: string;
  variant?: "default" | "dark";
}

const { slug, variant = "default" } = Astro.props;
const cat = categoryBySlug.get(slug);
if (!cat) throw new Error(`Unknown category: ${slug}`);
---

<a
  href={`/categories/${cat.slug}/`}
  class="group inline-block font-mono text-[10px] tracking-[0.22em] uppercase border px-2.5 py-1 transition-colors duration-200 border-[var(--color-rule)] text-[var(--color-ink-secondary)] hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)]"
>
  {cat.name}
</a>
