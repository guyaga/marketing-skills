---
const path = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === "/" ? path === "/" : path === prefix || path.startsWith(prefix + "/");
---

<header class="sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[var(--color-bg-base)]/85 backdrop-blur-xl supports-[backdrop-filter]:bg-[var(--color-bg-base)]/70">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 h-16 flex items-center justify-between">
    <a href="/" class="group flex items-baseline gap-3">
      <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] group-hover:text-[var(--color-brand-red)] transition-colors duration-200">guyaga</span>
      <span class="font-display text-xl text-[var(--color-ink-primary)] group-hover:text-[var(--color-brand-red)] transition-colors duration-200" style="font-variation-settings: 'SOFT' 50, 'WONK' 1;">marketing skills</span>
    </a>

    <nav class="flex items-center gap-7 text-sm">
      <a href="/team/" data-active={isActive("/team")} class={`nav-link relative py-1 transition-colors duration-200 ${isActive("/team") ? "text-[var(--color-brand-red)]" : "text-[var(--color-ink-primary)] hover:text-[var(--color-brand-red)]"}`}>Team</a>
      <a href="/skills/" data-active={isActive("/skills")} class={`nav-link relative py-1 transition-colors duration-200 ${isActive("/skills") ? "text-[var(--color-brand-red)]" : "text-[var(--color-ink-primary)] hover:text-[var(--color-brand-red)]"}`}>Skills</a>
      <a href="/install/" data-active={isActive("/install")} class={`nav-link relative py-1 transition-colors duration-200 ${isActive("/install") ? "text-[var(--color-brand-red)]" : "text-[var(--color-ink-primary)] hover:text-[var(--color-brand-red)]"}`}>Install</a>
      <a href="https://github.com/guyaga/marketing-skills" rel="noopener" class="font-mono text-[10px] tracking-[0.22em] uppercase border border-[var(--color-rule-strong)] text-[var(--color-ink-primary)] px-3 py-1.5 hover:bg-[var(--color-ink-primary)] hover:text-[var(--color-bg-base)] hover:border-[var(--color-ink-primary)] transition-all duration-200 active:scale-[0.97]">GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--color-brand-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link[data-active="true"]::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }
</style>
