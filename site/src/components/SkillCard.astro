---
import { categoryBySlug } from "../data/categories";
import { personaByCategory } from "../data/personas";
import type { SkillMeta } from "../data/skills-meta";

interface Props {
  skill: SkillMeta;
}

const { skill } = Astro.props;
const cat = categoryBySlug.get(skill.category);
const persona = personaByCategory.get(skill.category);
---

<a
  href={`/skills/${skill.slug}/`}
  data-category={skill.category}
  data-name={skill.slug}
  data-search={`${skill.name} ${skill.description}`.toLowerCase()}
  class="skill-card group block relative border border-[var(--color-rule)] bg-[var(--color-bg-elev-1)] hover:border-[var(--color-rule-strong)] transition-all duration-200 p-6 h-full flex flex-col overflow-hidden"
>
  <span class="pointer-events-none absolute top-0 left-0 right-0 h-px bg-[var(--color-brand-red)] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"></span>

  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-display text-xl text-[var(--color-ink-primary)] group-hover:text-[var(--color-brand-red)] transition-colors duration-200 leading-tight" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.015em;">
      {skill.name}
    </h3>
    <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] whitespace-nowrap pt-1">{cat?.name}</span>
  </div>

  <p class="text-[14px] leading-relaxed text-[var(--color-ink-secondary)] line-clamp-3">{skill.description}</p>

  <div class="mt-auto pt-5 flex items-center justify-between border-t border-[var(--color-rule)] mt-5">
    {persona ? (
      <div class="flex items-center gap-2">
        <img src={`/avatars/${persona.avatarSlug}.png`} alt={persona.name} loading="lazy" decoding="async" class="w-6 h-6 object-cover bg-[var(--color-bg-elev-2)] border border-[var(--color-rule)]" onerror="this.style.opacity='0.2'" />
        <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-ink-tertiary)]">{persona.name}</span>
      </div>
    ) : (
      <span></span>
    )}
    <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] group-hover:text-[var(--color-brand-red)] transition-colors duration-200">Open →</span>
  </div>
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
