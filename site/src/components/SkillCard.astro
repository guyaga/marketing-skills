---
import { categoryBySlug } from "../data/categories";
import type { SkillMeta } from "../data/skills-meta";

interface Props {
  skill: SkillMeta;
}

const { skill } = Astro.props;
const cat = categoryBySlug.get(skill.category);
---

<a
  href={`/skills/${skill.slug}/`}
  data-category={skill.category}
  data-name={skill.slug}
  data-search={`${skill.name} ${skill.description}`.toLowerCase()}
  class="skill-card group block border border-[var(--color-brand-rule)] bg-[var(--color-brand-paper)] hover:border-[var(--color-brand-black)] transition-colors p-6 h-full flex flex-col"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-display text-xl text-[var(--color-brand-black)] group-hover:text-[var(--color-brand-red)] transition-colors leading-tight">
      {skill.name}
    </h3>
    <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)] whitespace-nowrap pt-1">
      {cat?.name}
    </span>
  </div>
  <p class="text-sm leading-relaxed text-[var(--color-brand-black)]/80">
    {skill.description}
  </p>
  <div class="mt-auto pt-4 font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-brand-muted)] group-hover:text-[var(--color-brand-red)] transition-colors">
    Open →
  </div>
</a>
