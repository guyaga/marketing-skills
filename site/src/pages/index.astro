---
import BrandLayout from "../layouts/BrandLayout.astro";
import InstallSnippet from "../components/InstallSnippet.astro";
import PersonaAvatar from "../components/PersonaAvatar.astro";
import { categories } from "../data/categories";
import { skillsMeta } from "../data/skills-meta";
import { personas } from "../data/personas";

const totalSkills = skillsMeta.length;
const totalSpecialists = personas.length;
const skillsPerCategory = (slug: string) =>
  skillsMeta.filter((s) => s.category === slug).length;

// Hero persona for the bento (Elias - Brand Lead)
const heroPersona = personas[0];
const supportingPersonas = personas.slice(1);
---

<BrandLayout title="Marketing Skills" schemaType="homepage">
  <!-- HERO -->
  <section class="bg-grid-dark text-[var(--color-ink-primary)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 pt-24 pb-32 grid lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8" data-reveal-group>
        <div class="font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--color-brand-red)] mb-6" data-reveal>
          Marketing skills · v0.1
        </div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;" data-reveal>
          Your AI marketing team.<br />
          {totalSpecialists} specialists. One install.
        </h1>
        <p class="mt-8 text-lg text-[var(--color-ink-secondary)] max-w-2xl leading-relaxed" data-reveal>
          {totalSkills} skills, organized by role. The Conversion Specialist owns CRO. The Strategist owns positioning. The Media Buyer owns paid. You ask the question, the right specialist steps in. One command drops the whole team into Claude Code, Cursor, and Codex.
        </p>
        <div class="mt-10 max-w-xl" data-reveal>
          <InstallSnippet
            label="Install (recommended)"
            command="npx skills add guyaga/marketing-skills"
            variant="deep"
          />
        </div>
        <div class="mt-6 flex gap-4 text-sm" data-reveal>
          <a href="/skills/" class="font-mono text-xs tracking-[0.22em] uppercase border border-[var(--color-rule-strong)] text-[var(--color-ink-primary)] px-4 py-2 hover:bg-[var(--color-ink-primary)] hover:text-[var(--color-bg-base)] hover:border-[var(--color-ink-primary)] transition-all duration-200 active:scale-[0.97]">
            Browse {totalSkills} skills →
          </a>
          <a href="/install/" class="font-mono text-xs tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] px-4 py-2 hover:text-[var(--color-brand-red)] transition-colors duration-200">
            Other install methods
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 lg:pl-8 lg:border-l border-[var(--color-rule)] hidden lg:block" data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-4">
          What it covers
        </div>
        <ul class="space-y-3 text-sm text-[var(--color-ink-secondary)]">
          {categories.map((c) => (
            <li class="flex justify-between border-b border-[var(--color-rule)] pb-2">
              <span>{c.name}</span>
              <span class="font-mono text-[var(--color-ink-tertiary)]">{skillsPerCategory(c.slug).toString().padStart(2, "0")}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- KINETIC MARQUEE -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-deeper)] overflow-hidden">
    <div class="marquee-track py-4">
      {Array.from({ length: 4 }).map(() => (
        <div class="marquee-item">
          <span>{totalSpecialists} SPECIALISTS</span><span class="marquee-dot"></span>
          <span>{totalSkills} SKILLS</span><span class="marquee-dot"></span>
          <span>ONE INSTALL</span><span class="marquee-dot"></span>
          <span>CRO · COPY · SEO · PAID · RETENTION · GROWTH</span><span class="marquee-dot"></span>
          <span>FOR CLAUDE CODE · CURSOR · CODEX</span><span class="marquee-dot"></span>
          <span>MIT LICENSED</span><span class="marquee-dot"></span>
        </div>
      ))}
    </div>
  </section>

  <!-- BENTO TEAM GRID -->
  <section class="bg-[var(--color-bg-base)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24">
      <div class="flex items-baseline justify-between mb-10 border-b border-[var(--color-rule)] pb-4" data-reveal>
        <div>
          <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-2">Meet the team</div>
          <h2 class="font-display text-3xl md:text-4xl text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.02em;">Ten specialists, named and ready.</h2>
        </div>
        <a href="/team/" class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-secondary)] hover:text-[var(--color-brand-red)] transition-colors duration-200 hidden md:block">
          Read the full roster →
        </a>
      </div>

      <!-- Bento: 1 hero (2x2) + 3 in row 1 + 3 in row 2 + 3 in row 3 -->
      <div class="bento-grid" data-reveal-group>
        <a href={`/categories/${heroPersona.category}/`} class="bento-tile bento-hero group relative overflow-hidden border border-[var(--color-rule-strong)] bg-[var(--color-bg-elev-2)]" data-reveal>
          <picture>
            <source type="image/webp" srcset={`/avatars/${heroPersona.avatarSlug}-768.webp`} />
            <img src={`/avatars/${heroPersona.avatarSlug}.png`} alt={`${heroPersona.name}, ${heroPersona.role}`} loading="eager" decoding="sync" fetchpriority="high" width="768" height="768" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-base)]/95 via-[var(--color-bg-base)]/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-2">{heroPersona.role}</div>
            <div class="font-display text-3xl md:text-4xl text-[var(--color-ink-primary)] leading-tight" style="font-variation-settings: 'SOFT' 50, 'WONK' 1;">{heroPersona.name}</div>
            <p class="font-mono text-xs text-[var(--color-ink-secondary)] mt-3 max-w-md leading-snug">"{heroPersona.philosophy}"</p>
          </div>
          <span class="absolute top-0 left-0 right-0 h-px bg-[var(--color-brand-red)] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"></span>
        </a>
        {supportingPersonas.map((p) => (
          <a href={`/categories/${p.category}/`} class="bento-tile group relative overflow-hidden border border-[var(--color-rule)] bg-[var(--color-bg-elev-2)] hover:border-[var(--color-rule-strong)] transition-colors duration-200" data-reveal>
            <picture>
              <source type="image/webp" srcset={`/avatars/${p.avatarSlug}-384.webp`} />
              <img src={`/avatars/${p.avatarSlug}.png`} alt={`${p.name}, ${p.role}`} loading="lazy" decoding="async" width="384" height="384" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.06]" />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-base)]/90 via-[var(--color-bg-base)]/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 md:p-4">
              <div class="font-display text-base md:text-lg text-[var(--color-ink-primary)] leading-tight group-hover:text-[var(--color-brand-red)] transition-colors duration-200" style="font-variation-settings: 'SOFT' 50;">{p.name}</div>
              <div class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-ink-tertiary)] mt-0.5">{p.role}</div>
            </div>
            <span class="absolute top-0 left-0 right-0 h-px bg-[var(--color-brand-red)] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"></span>
          </a>
        ))}
      </div>

      <div class="mt-8 md:hidden" data-reveal>
        <a href="/team/" class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-secondary)] hover:text-[var(--color-brand-red)] transition-colors duration-200">Read the full roster →</a>
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="bg-[var(--color-bg-base)] border-t border-[var(--color-rule)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24">
      <div class="flex items-baseline justify-between mb-12 border-b border-[var(--color-rule)] pb-4" data-reveal>
        <h2 class="font-display text-3xl md:text-4xl text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.02em;">Ten categories</h2>
        <a href="/skills/" class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-secondary)] hover:text-[var(--color-brand-red)] transition-colors duration-200">
          See all {totalSkills} →
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6" data-reveal-group>
        {categories.map((c) => (
          <a href={`/categories/${c.slug}/`} class="group block relative border border-[var(--color-rule)] bg-[var(--color-bg-elev-1)] hover:border-[var(--color-rule-strong)] transition-all duration-200 p-7 overflow-hidden" data-reveal>
            <span class="pointer-events-none absolute top-0 left-0 right-0 h-px bg-[var(--color-brand-red)] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"></span>
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="font-display text-2xl text-[var(--color-ink-primary)] group-hover:text-[var(--color-brand-red)] transition-colors duration-200" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.015em;">
                {c.name}
              </h3>
              <span class="font-mono text-xs text-[var(--color-ink-tertiary)]">
                {skillsPerCategory(c.slug).toString().padStart(2, "0")} skills
              </span>
            </div>
            <p class="text-sm text-[var(--color-ink-secondary)] leading-relaxed">
              {c.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-[var(--color-bg-deeper)] border-y border-[var(--color-rule)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24 grid md:grid-cols-3 gap-12" data-reveal-group>
      <div data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-4">01 · Install</div>
        <h3 class="font-display text-2xl mb-4 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50;">One command, all {totalSkills} skills.</h3>
        <p class="text-sm leading-relaxed text-[var(--color-ink-secondary)]">
          <code class="font-mono text-xs text-[var(--color-brand-warm)] bg-[var(--color-bg-elev-1)] border border-[var(--color-rule)] px-2 py-0.5">npx skills add guyaga/marketing-skills</code>
          drops the skill files into <code class="font-mono text-xs text-[var(--color-brand-warm)] bg-[var(--color-bg-elev-1)] border border-[var(--color-rule)] px-2 py-0.5">.agents/skills/</code> and symlinks them for Claude Code.
        </p>
      </div>
      <div data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-4">02 · Set context</div>
        <h3 class="font-display text-2xl mb-4 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50;">Run product-marketing-context first.</h3>
        <p class="text-sm leading-relaxed text-[var(--color-ink-secondary)]">
          Every other skill reads this document before it does anything. It is your audience, positioning, and voice in one place. The agent fills it in with you.
        </p>
      </div>
      <div data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-4">03 · Ship work</div>
        <h3 class="font-display text-2xl mb-4 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50;">Then ask the agent to do anything.</h3>
        <p class="text-sm leading-relaxed text-[var(--color-ink-secondary)]">
          "Write a comparison page against [competitor]." "Audit my signup flow." "Plan our launch." Each skill is a structured prompt the agent runs end to end.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-bg-base)]">
    <div class="max-w-3xl mx-auto px-6 md:px-10 py-24 text-center" data-reveal>
      <h2 class="font-display text-4xl md:text-5xl mb-6 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;">Ready when you are.</h2>
      <p class="text-lg text-[var(--color-ink-secondary)] mb-8">
        {totalSkills} skills, MIT licensed, install in under a minute.
      </p>
      <div class="max-w-xl mx-auto">
        <InstallSnippet command="npx skills add guyaga/marketing-skills" />
      </div>
    </div>
  </section>
</BrandLayout>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 220px;
    gap: 12px;
  }
  .bento-hero {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 220px;
    }
  }
  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(5, 1fr);
      grid-auto-rows: 200px;
    }
  }
</style>
