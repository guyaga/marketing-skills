---
import BrandLayout from "../../layouts/BrandLayout.astro";
import SkillCard from "../../components/SkillCard.astro";
import PersonaCard from "../../components/PersonaCard.astro";
import { categories, categoryBySlug } from "../../data/categories";
import { skillsByCategory } from "../../data/skills-meta";
import { personaByCategory } from "../../data/personas";

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}

const { slug } = Astro.props;
const cat = categoryBySlug.get(slug)!;
const skills = skillsByCategory(slug);
const persona = personaByCategory.get(slug);
---

<BrandLayout title={cat.name} description={cat.description}>
  <section class="bg-[var(--color-bg-base)]">
    <header class="border-b border-[var(--color-rule)] bg-[var(--color-bg-deeper)]">
      <div class="max-w-[1280px] mx-auto px-6 md:px-10 pt-20 pb-14">
        <nav class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-7 flex gap-2">
          <a href="/" class="hover:text-[var(--color-brand-red)] transition-colors duration-200">Home</a>
          <span>/</span>
          <a href="/skills/" class="hover:text-[var(--color-brand-red)] transition-colors duration-200">Categories</a>
        </nav>

        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-3">
          Category · {skills.length} skills
        </div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[1.05] mb-6 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;">{cat.name}</h1>
        <p class="text-lg text-[var(--color-ink-secondary)] max-w-3xl leading-relaxed">{cat.description}</p>
      </div>
    </header>

    {persona && (
      <div class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 border-b border-[var(--color-rule)]">
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-8">Who owns this practice</div>
        <PersonaCard persona={persona} variant="full" />
      </div>
    )}

    <div class="max-w-[1280px] mx-auto px-6 md:px-10 py-16">
      <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-7">The {skills.length} skills in this practice</div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {skills.map((s) => <SkillCard skill={s} />)}
      </div>
    </div>

    <div class="max-w-[1280px] mx-auto px-6 md:px-10 pb-20 border-t border-[var(--color-rule)] pt-12">
      <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-4">Other categories</div>
      <div class="flex flex-wrap gap-2">
        {categories.filter((c) => c.slug !== slug).map((c) => (
          <a href={`/categories/${c.slug}/`} class="font-mono text-[10px] tracking-[0.22em] uppercase border border-[var(--color-rule)] text-[var(--color-ink-secondary)] hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)] px-3 py-1.5 transition-colors duration-200">{c.name}</a>
        ))}
      </div>
    </div>
  </section>
</BrandLayout>
