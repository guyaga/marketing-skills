---
import BrandLayout from "../../layouts/BrandLayout.astro";
import SkillCard from "../../components/SkillCard.astro";
import PersonaCard from "../../components/PersonaCard.astro";
import { categories, categoryBySlug } from "../../data/categories";
import { skillsByCategory } from "../../data/skills-meta";
import { personaByCategory } from "../../data/personas";

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}

const { slug } = Astro.props;
const cat = categoryBySlug.get(slug)!;
const skills = skillsByCategory(slug);
const persona = personaByCategory.get(slug);
const heroSlug = persona?.avatarSlug;
---

<BrandLayout
  title={cat.name}
  description={`${cat.description} ${skills.length} marketing skills for AI agents in this practice.`}
  schemaType="category"
  categorySlug={slug}
  breadcrumbs={[
    { name: "Home", url: "https://marketing-skills.guyaga.ai/" },
    { name: "Categories", url: "https://marketing-skills.guyaga.ai/skills/" },
    { name: cat.name, url: `https://marketing-skills.guyaga.ai/categories/${slug}/` },
  ]}
>
  <section class="bg-[var(--color-bg-base)]">
    <!-- Hero band — full-bleed wide creature portrait + text overlay on left -->
    <header class="relative overflow-hidden border-b border-[var(--color-rule)] bg-[var(--color-bg-deeper)]">
      {heroSlug && (
        <div class="absolute inset-0 pointer-events-none">
          <!-- Video on motion-friendly clients, poster fallback otherwise -->
          <video
            class="hero-video absolute inset-y-0 right-0 h-full w-[70%] object-cover object-right opacity-90"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            poster={`/avatars/heroes/${heroSlug}-1024.webp`}
            src={`/avatars/heroes/${heroSlug}-motion.mp4`}
            aria-hidden="true"
            onerror="this.style.display='none'; this.nextElementSibling && (this.nextElementSibling.style.display='block');"
          ></video>
          <!-- Static fallback (shown if video fails or prefers-reduced-motion) -->
          <picture class="hero-static absolute inset-y-0 right-0 h-full w-[70%]">
            <source type="image/webp" srcset={`/avatars/heroes/${heroSlug}-1536.webp`} media="(min-width: 1024px)" />
            <source type="image/webp" srcset={`/avatars/heroes/${heroSlug}-1024.webp`} media="(min-width: 640px)" />
            <source type="image/webp" srcset={`/avatars/heroes/${heroSlug}-640.webp`} />
            <img
              src={`/avatars/heroes/${heroSlug}-wide.png`}
              alt=""
              loading="eager"
              decoding="sync"
              width="1536"
              height="1024"
              class="absolute inset-0 h-full w-full object-cover object-right opacity-90"
            />
          </picture>
          <!-- Gradient overlay: fades from solid bg-deeper on left to transparent on right -->
          <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-deeper)] via-[var(--color-bg-deeper)]/80 to-transparent"></div>
          <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--color-bg-deeper)]/60 to-transparent"></div>
        </div>
      )}

      <style>
        /* Show video when it's available; hide static fallback */
        .hero-static { display: none; }
        /* If user prefers reduced motion, hide video and show static */
        @media (prefers-reduced-motion: reduce) {
          .hero-video { display: none !important; }
          .hero-static { display: block !important; }
        }
      </style>

      <div class="relative max-w-[1400px] mx-auto px-6 md:px-10 pt-20 pb-20 lg:pb-28 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7" data-reveal-group>
          <nav class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-7 flex flex-wrap gap-2" data-reveal>
            <a href="/" class="hover:text-[var(--color-brand-red)] transition-colors duration-200">Home</a>
            <span>/</span>
            <a href="/skills/" class="hover:text-[var(--color-brand-red)] transition-colors duration-200">Categories</a>
          </nav>

          <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-3" data-reveal>
            {persona?.role ?? "Category"} · {skills.length} skills
          </div>
          <h1 class="font-display text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[1.0] mb-6 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;" data-reveal>{cat.name}</h1>
          <p class="text-lg text-[var(--color-ink-secondary)] max-w-2xl leading-relaxed mb-8" data-reveal>{cat.description}</p>

          {persona && (
            <div class="flex flex-wrap items-center gap-4" data-reveal>
              <div class="font-mono text-xs tracking-[0.18em] uppercase text-[var(--color-ink-tertiary)]">
                Owned by <span class="text-[var(--color-ink-primary)]">{persona.name}</span>
              </div>
              <span class="font-mono text-xs text-[var(--color-ink-tertiary)]">·</span>
              <a href="/team/" class="font-mono text-xs tracking-[0.18em] uppercase text-[var(--color-ink-tertiary)] hover:text-[var(--color-brand-red)] transition-colors">See full team →</a>
            </div>
          )}
        </div>
      </div>
    </header>

    {persona && (
      <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-16 border-b border-[var(--color-rule)]" data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-8">Who owns this practice</div>
        <PersonaCard persona={persona} variant="full" />
      </div>
    )}

    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-16">
      <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-7" data-reveal>The {skills.length} skills in this practice</div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal-group>
        {skills.map((s) => (
          <div data-reveal>
            <SkillCard skill={s} />
          </div>
        ))}
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-6 md:px-10 pb-20 border-t border-[var(--color-rule)] pt-12">
      <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-4">Other categories</div>
      <div class="flex flex-wrap gap-2">
        {categories.filter((c) => c.slug !== slug).map((c) => (
          <a href={`/categories/${c.slug}/`} class="font-mono text-[10px] tracking-[0.22em] uppercase border border-[var(--color-rule)] text-[var(--color-ink-secondary)] hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)] px-3 py-1.5 transition-colors duration-200">{c.name}</a>
        ))}
      </div>
    </div>
  </section>
</BrandLayout>
