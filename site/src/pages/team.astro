---
import BrandLayout from "../layouts/BrandLayout.astro";
import PersonaCard from "../components/PersonaCard.astro";
import PersonaAvatar from "../components/PersonaAvatar.astro";
import InstallSnippet from "../components/InstallSnippet.astro";
import { personas } from "../data/personas";
import { story } from "../data/story";
import { skillsMeta } from "../data/skills-meta";
import { skillsByCategory } from "../data/skills-meta";

// Hero persona — Elias as the face of the team
const heroPersona = personas[0];
const heroOwns = skillsByCategory(heroPersona.category);
---

<BrandLayout
  title="The Team"
  description="The ten specialists in your AI marketing team — Brand Lead, Conversion Specialist, Copy Chief, SEO Lead, Media Buyer, Strategist, Customer Success Lead, Growth Engineer, Operator, Analyst."
  schemaType="team"
  breadcrumbs={[
    { name: "Home", url: "https://marketing-skills.guyaga.ai/" },
    { name: "The Team", url: "https://marketing-skills.guyaga.ai/team/" },
  ]}
>
  <!-- HERO — asymmetric split with breathing hero persona on the right -->
  <section class="bg-grid-dark relative overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 pt-24 pb-24 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7" data-reveal-group>
        <div class="font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--color-brand-red)] mb-6" data-reveal>
          Ten specialists · {skillsMeta.length} skills
        </div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[1.0] text-[var(--color-ink-primary)] mb-8" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;" data-reveal>
          {story.hookHeadline}
        </h1>
        <p class="text-lg text-[var(--color-ink-secondary)] max-w-2xl leading-relaxed mb-8" data-reveal>
          {story.hookSub}
        </p>
        <div class="flex flex-wrap items-center gap-4" data-reveal>
          <a href="#roster" class="font-mono text-xs tracking-[0.22em] uppercase border border-[var(--color-rule-strong)] text-[var(--color-ink-primary)] px-4 py-2.5 hover:bg-[var(--color-ink-primary)] hover:text-[var(--color-bg-base)] hover:border-[var(--color-ink-primary)] transition-all duration-200 active:scale-[0.97]">
            Meet all ten →
          </a>
          <a href="#origin" class="font-mono text-xs tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] px-2 py-2.5 hover:text-[var(--color-brand-red)] transition-colors">
            Why these ten ↓
          </a>
        </div>
      </div>

      <!-- Right column: cinematic hero portrait video + floating mono labels -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end" data-reveal>
        <div class="relative w-full max-w-[480px] aspect-[3/2] overflow-hidden border border-[var(--color-rule-strong)] bg-[var(--color-bg-elev-2)]">
          <video
            class="team-hero-video absolute inset-0 w-full h-full object-cover"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            poster={`/avatars/heroes/${heroPersona.avatarSlug}-1024.webp`}
            src={`/avatars/heroes/${heroPersona.avatarSlug}-motion.mp4`}
            aria-hidden="true"
          ></video>
          <picture class="team-hero-static absolute inset-0">
            <source type="image/webp" srcset={`/avatars/heroes/${heroPersona.avatarSlug}-1024.webp`} />
            <img src={`/avatars/heroes/${heroPersona.avatarSlug}-wide.png`} alt={`${heroPersona.name}, ${heroPersona.role}`} loading="eager" decoding="sync" fetchpriority="high" width="1024" height="683" class="absolute inset-0 w-full h-full object-cover" />
          </picture>
          <!-- floating mono labels around the video -->
          <div class="absolute top-3 left-3 md:top-4 md:left-4">
            <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] bg-[var(--color-bg-deeper)]/80 backdrop-blur px-2 py-1 border border-[var(--color-rule)]">
              01 · {heroPersona.role}
            </div>
          </div>
          <div class="absolute bottom-3 right-3 max-w-[280px] text-right">
            <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ink-tertiary)] mb-1">Owns</div>
            <div class="font-mono text-xs text-[var(--color-ink-primary)] leading-snug bg-[var(--color-bg-deeper)]/80 backdrop-blur px-2 py-1 border border-[var(--color-rule)] inline-block">
              {heroOwns.map((s) => s.name).join(" · ")}
            </div>
          </div>
        </div>
      </div>

      <style>
        .team-hero-static { display: none; }
        @media (prefers-reduced-motion: reduce) {
          .team-hero-video { display: none !important; }
          .team-hero-static { display: block !important; }
        }
      </style>
    </div>
  </section>

  <!-- KINETIC MARQUEE -->
  <section class="border-y border-[var(--color-rule)] bg-[var(--color-bg-deeper)] overflow-hidden">
    <div class="marquee-track py-4">
      {Array.from({ length: 4 }).map(() => (
        <div class="marquee-item">
          <span>10 SPECIALISTS</span><span class="marquee-dot"></span>
          <span>{skillsMeta.length} SKILLS</span><span class="marquee-dot"></span>
          <span>ONE INSTALL</span><span class="marquee-dot"></span>
          <span>CRO · COPY · SEO · PAID · RETENTION</span><span class="marquee-dot"></span>
          <span>MIT LICENSED</span><span class="marquee-dot"></span>
          <span>FOR CLAUDE CODE · CURSOR · CODEX</span><span class="marquee-dot"></span>
        </div>
      ))}
    </div>
  </section>

  <!-- ORIGIN STORY -->
  <section id="origin" class="bg-[var(--color-bg-deeper)] border-b border-[var(--color-rule)]">
    <div class="max-w-4xl mx-auto px-6 md:px-10 py-24" data-reveal-group>
      <h2 class="font-display text-3xl md:text-4xl mb-10 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.02em;" data-reveal>{story.origin.title}</h2>
      <div class="space-y-5 text-[17px] leading-relaxed text-[var(--color-ink-primary)]/90">
        {story.origin.body.map((para) => <p data-reveal>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- TEAM ROSTER -->
  <section id="roster" class="bg-[var(--color-bg-base)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24">
      <div class="border-b border-[var(--color-rule)] pb-4 mb-16" data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-2">The roster</div>
        <h2 class="font-display text-3xl md:text-4xl text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.02em;">Ten specialists, one team.</h2>
      </div>
      <div class="space-y-16" data-reveal-group>
        {personas.map((p) => (
          <div data-reveal>
            <PersonaCard persona={p} variant="full" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="bg-grid-dark text-[var(--color-ink-primary)] border-t border-[var(--color-rule)]">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24">
      <div data-reveal>
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-brand-red)] mb-2">How the team works</div>
        <h2 class="font-display text-3xl md:text-4xl mb-16 max-w-3xl text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50; letter-spacing: -0.02em;">Four principles the team operates by.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12" data-reveal-group>
        {story.philosophyPoints.map((pt, i) => (
          <div class="border-t border-[var(--color-rule)] pt-7" data-reveal>
            <div class="font-mono text-3xl text-[var(--color-brand-red)] mb-4">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="font-display text-2xl mb-4 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50;">{pt.title}</h3>
            <p class="text-[15px] leading-relaxed text-[var(--color-ink-secondary)]">{pt.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-bg-base)]">
    <div class="max-w-3xl mx-auto px-6 md:px-10 py-24 text-center" data-reveal>
      <h2 class="font-display text-4xl md:text-5xl mb-6 text-[var(--color-ink-primary)]" style="font-variation-settings: 'SOFT' 50, 'WONK' 1; letter-spacing: -0.025em;">{story.installPromise.headline}</h2>
      <p class="text-lg text-[var(--color-ink-secondary)] mb-8">{story.installPromise.body}</p>
      <div class="max-w-xl mx-auto">
        <InstallSnippet command="npx skills add guyaga/brief" />
      </div>
    </div>
  </section>
</BrandLayout>
